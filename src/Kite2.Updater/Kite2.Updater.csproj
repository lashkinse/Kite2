<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- Обновлятор собирается как любая сборка: WINDOW-консоль мелькала бы при
         каждом обновлении, поэтому исполняемым окном он не бывает вовсе. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Platforms>x64</Platforms>
    <RootNamespace>Kite2.Update</RootNamespace>
    <AssemblyName>Kite2.Updater</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Папка сборки повторяет решение (x64), хотя двоичник безразличен к разрядности:
       сборка решения одна на все проекты. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>bin\x64\Release\</OutputPath>
    <Optimize>true</Optimize>
  </PropertyGroup>

</Project>
