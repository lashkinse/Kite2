<Window x:Class="Kite2.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Kite2.App.Views"
        xmlns:controls="clr-namespace:Kite2.App.Controls"
        Title="Kite2"
        Icon="pack://application:,,,/Kite2;component/icon.ico"
        Width="1000"
        Height="600"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bar}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Главное окно: тёмная панель команд сверху, под ней рабочая область —
         колонка страниц слева, полоса команд над выбранной страницей и просмотр. -->

    <!-- Горячие клавиши. Заданы на окне, а не на кнопках: работают при любом фокусе
         внутри программы, в том числе на колонке страниц и на листе. Выделения
         участка отдельного режима нет: протягивание мышью всегда отмечает участок,
         а лист двигают средней кнопкой. -->
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewDocumentCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RotatePageCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeletePageCommand}" />
        <KeyBinding Key="Up" Modifiers="Control" Command="{Binding MovePageUpCommand}" />
        <KeyBinding Key="Down" Modifiers="Control" Command="{Binding MovePageDownCommand}" />
        <KeyBinding Key="Add" Command="{Binding ScanAgainCommand}" />
        <KeyBinding Key="OemPlus" Command="{Binding ScanAgainCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Панель команд. Кнопки перечислены в порядке работы с документом:
             создать, сохранить, отсканировать, выбрать источник. Команды над
             отдельной страницей вынесены из неё в плавающую панель у колонки.
             Панель прижата влево, а не отцентрована: с набором кнопок посредине
             панель уезжает от левого края при разной длине подсказок. -->
        <Border Grid.Row="0" Background="{StaticResource Bar}" Height="{StaticResource BarHeight}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">

                <Button Style="{StaticResource CommandButtonStyle}" Content="Создать" controls:CommandBar.Hint="Ctrl+N" Tag="{StaticResource IconNew}"
                        ToolTip="Создать новый документ (Ctrl+N)" Command="{Binding NewDocumentCommand}" />

                <!-- Формат выбирается в окне сохранения, поэтому отдельного списка
                     под кнопкой больше нет: он повторял то, что окно и так спрашивает. -->
                <Button Style="{StaticResource AccentCommandButtonStyle}" Content="Сохранить"
                        controls:CommandBar.Hint="Ctrl+S" Tag="{StaticResource IconSave}"
                        ToolTip="Сохранить документ: формат выбирается в окне сохранения (Ctrl+S)"
                        Command="{Binding SaveCommand}" />

                <Rectangle Style="{StaticResource ToolBarSeparatorStyle}" />

                <!-- Рамка на кнопке последнего режима: по ней видно, в каком режиме
                     повторит сканирование «+». -->
                <Button Style="{StaticResource CommandButtonStyle}" Content="Ч/Б" controls:CommandBar.Hint="+" Tag="{StaticResource IconScanMono}"
                        controls:CommandBar.IsNext="{Binding LastScanIsMono}"
                        ToolTip="Сканировать в чёрно-белом режиме (+)" Command="{Binding ScanMonoCommand}" />

                <Button Style="{StaticResource CommandButtonStyle}" Content="Цветное" controls:CommandBar.Hint="+" Tag="{StaticResource IconScanColour}"
                        controls:CommandBar.IsNext="{Binding LastScanIsColour}"
                        ToolTip="Сканировать в цветном режиме (+)" Command="{Binding ScanColourCommand}" />
                <Rectangle Style="{StaticResource ToolBarSeparatorStyle}" />

                <!-- Настройки отделены чертой от сканирования: это уже не про
                     захват, а про то, чем захватывают. -->
                <Button Style="{StaticResource CommandButtonStyle}" Content="Настройки" Tag="{StaticResource IconSettings}"
                        ToolTip="Выбрать источник сканирования" Command="{Binding SettingsCommand}" />
            </StackPanel>
        </Border>

        <!-- Рабочая область: колонка страниц и просмотр. Команды над выбранной
             страницей плавают поверх просмотра — в панели сверху осталось только
             то, что относится ко всему документу. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <views:PageRail Grid.Column="0" />
            <views:PageViewer x:Name="Viewer" Grid.Column="1" />

            <views:PageActions x:Name="Actions"
                              Grid.Column="1"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Visibility="Collapsed" />

            <!-- Плашка сообщения поверх рабочей области, в её правом нижнем углу. -->
            <views:NoticeBar Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" />
        </Grid>
    </Grid>
</Window>
