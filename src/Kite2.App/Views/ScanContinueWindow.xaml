<Window x:Class="Kite2.App.Views.ScanContinueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сканирование"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource FontSizeUi}">

    <!-- Вопрос после серии сканирования. Раньше здесь были два переключателя и
         кнопка «ОК»: выбор приходилось подтверждать вторым нажатием, и Esc означал
         не то, чего ждёт. Теперь ответ выбирается сразу одной кнопкой, а подписи
         подсказывают клавиши. -->
    <StackPanel Margin="20">

        <TextBlock x:Name="Caption"
                   Text="Укажите, завершено ли сканирование, или нужно отсканировать дополнительные страницы, чтобы закончить этот документ"
                   TextWrapping="Wrap"
                   MaxWidth="420"
                   Foreground="{StaticResource TextPrimary}"
                   HorizontalAlignment="Left" />

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="StopButton"
                    Content="Завершить"
                    Height="32"
                    FontSize="13"
                    IsDefault="True"
                    Click="OnStopClick" />

            <Button Grid.Column="2"
                    x:Name="ContinueButton"
                    Content="Сканировать ещё"
                    Height="32"
                    FontSize="13"
                    Click="OnContinueClick" />

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
        </Grid>

        <!-- Подсказки о клавишах: те же сочетания работают и на верхней панели. -->
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="[Enter]"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="{StaticResource FontSizeSmall}" />

            <TextBlock Grid.Column="2"
                       Text="[+]"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="{StaticResource FontSizeSmall}" />
        </Grid>
    </StackPanel>
</Window>