<UserControl x:Class="Kite2.App.Views.NoticeBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Плашка сообщения в правом нижнем углу рабочей области. Внизу и справа:
         сверху она закрывала край страницы и выглядела частью макета. -->
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding NoticeVisible}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Border x:Name="Plate"
            CornerRadius="4"
            Padding="16,0"
            Height="36"
            SnapsToDevicePixels="True">
        <Border.Style>
            <Style TargetType="Border">
                <!-- Тёмная плашка — ход работы, акцентная — результат: иначе
                     «идёт» и «готово» выглядели бы одинаково. -->
                <Setter Property="Background" Value="{StaticResource Toast}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding NoticeIsResult}" Value="True">
                        <Setter Property="Background" Value="{StaticResource Accent}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding NoticeText}"
                       Foreground="White"
                       FontFamily="{StaticResource UiFont}"
                       FontSize="{StaticResource FontSizeUi}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       MaxWidth="360" />

            <Button Content="Отмена"
                    Command="{Binding CancelNoticeCommand}"
                    Visibility="{Binding CancelWanted, Converter={StaticResource BoolToVisibility}}"
                    Margin="12,0,0,0"
                    MinWidth="80"
                    Height="26"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Padding="10,0"
                    Cursor="Hand"
                    Foreground="White"
                    Background="#4A4A4A"
                    BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Background"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <!-- Выравнивание по центру задано явно и по обеим осям:
                                 без него надпись прижималась к левому краю кнопки,
                                 а оставалось свободное место справа. -->
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="#5E5E5E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</UserControl>