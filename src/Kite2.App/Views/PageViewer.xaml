<UserControl x:Class="Kite2.App.Views.PageViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Область просмотра страницы: серый стол, на нём по центру белый лист.
         Область просмотра не забирает клавиатурный фокус и не рисует его рамку.
         Когда страницы нет, щелчок попадает на пустой серый стол, и полоса
         прокрутки забирала фокус — WPF обводила её пунктиром, будто сломанная. -->
    <Grid x:Name="Root"
          Background="{StaticResource Canvas}"
          Focusable="False"
          FocusVisualStyle="{x:Null}">

        <ScrollViewer x:Name="Scroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      PanningMode="Both"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}">
            <Canvas Background="Transparent">
                <!-- Лист. Размер задаётся прямо в коде: он равен размеру страницы,
                     умноженному на масштаб. Отдельного масштабирующего преобразования
                     здесь нет намеренно — вместе с размером оно давало бы квадрат
                     масштаба, и лист схлопывался бы в угол.

                     Слой выделения поверх листа ловит щелчки и рисует рамку: иначе
                     события мыши доходили бы до картинки, а не до области просмотра,
                     и выделение жило бы в другом элементе. -->
                <Border x:Name="Sheet"
                        Background="{StaticResource Page}"
                        BorderBrush="{StaticResource PageBorder}"
                        BorderThickness="1">
                    <Grid ClipToBounds="True">
                        <Image x:Name="Picture" Stretch="Fill" />

                        <!-- Слой выделения — полотно: рамка и точки ставятся в
                             координаты листа, а в сетке такие координаты
                             игнорируются, и выделение оставалось невидимым. -->
                        <Canvas IsHitTestVisible="False">
                            <!-- Выделенный участок: пунктирная рамка и точки по углам.
                                 Пунктир заметен и на белом листе, и на полутоновых
                                 участках страницы, а точки показывают, где за него
                                 взяться. -->
                            <Rectangle x:Name="Selection"
                                       Stroke="{StaticResource SelectionStroke}"
                                       StrokeThickness="1.5"
                                       StrokeDashArray="3,2"
                                       Visibility="Collapsed" />

                            <Rectangle Width="6" Height="6" Fill="{StaticResource SelectionStroke}" RadiusX="1" RadiusY="1"
                                       x:Name="HandleTopLeft" Visibility="Collapsed" />
                            <Rectangle Width="6" Height="6" Fill="{StaticResource SelectionStroke}" RadiusX="1" RadiusY="1"
                                       x:Name="HandleTopRight" Visibility="Collapsed" />
                            <Rectangle Width="6" Height="6" Fill="{StaticResource SelectionStroke}" RadiusX="1" RadiusY="1"
                                       x:Name="HandleBottomLeft" Visibility="Collapsed" />
                            <Rectangle Width="6" Height="6" Fill="{StaticResource SelectionStroke}" RadiusX="1" RadiusY="1"
                                       x:Name="HandleBottomRight" Visibility="Collapsed" />
                        </Canvas>
                    </Grid>
                </Border>
            </Canvas>
        </ScrollViewer>

        <!-- Полотно обрезано по краям области просмотра. Панель выделения стоит
             у угла рамки и не прилипает к краям, но за пределы просмотра не
             выходит: иначе она наезжала бы на панель команд и полосу прокрутки. -->
        <Canvas x:Name="Overlay" ClipToBounds="True">
            <!-- Панель выделения у левого верхнего угла рамки: отмена по Esc и
                 сохранение фрагмента в одной строке, все средства выделения
                 вместе и всегда в верхней части листа, у плашки сообщений. -->
            <Border x:Name="SelectionHint"
                    Visibility="Collapsed"
                    Background="{StaticResource Page}"
                    BorderBrush="{StaticResource SelectionStroke}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="6,2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Esc — отменить"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center"
                               MaxWidth="360" />
                    <Button x:Name="FragmentSave"
                            Width="26"
                            Height="22"
                            Margin="6,0,0,0"
                            Focusable="False"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="Сохранить выделенный участок страницы файлом PNG"
                            Click="OnCropClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Plate"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="3">
                                    <Path Style="{StaticResource ChipIconStyle}"
                                          Data="{StaticResource IconSaveFragment}"
                                          Fill="{StaticResource SelectionStroke}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Plate" Property="Background" Value="#E8F1FC" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Plate" Property="Background" Value="#CFE3FB" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Canvas>

        <!-- Подсказка, когда страниц нет: пустой стол сам по себе ничего не объясняет. -->
        <TextBlock x:Name="Placeholder"
                   Text="Отсканируйте страницу кнопкой «Сканировать»"
                   FontFamily="{StaticResource UiFont}"
                   FontSize="{StaticResource FontSizeUi}"
                   Foreground="{StaticResource TextSecondary}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False" />
    </Grid>
</UserControl>
