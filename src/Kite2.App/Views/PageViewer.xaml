<UserControl x:Class="Kite2.App.Views.PageViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Область просмотра страницы: серый стол, на нём белый лист. -->
    <Grid x:Name="Root" Background="{StaticResource Canvas}">

        <!-- Полосы прокрутки тонкие и собственного цвета: на сером столе
             стандартная полоса выглядит чужой полосой. -->
        <ScrollViewer x:Name="Scroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      PanningMode="Both">
            <Canvas Background="Transparent">
                <!-- Лист. Размер задаётся прямо в коде: он равен размеру страницы, умноженному
                     на масштаб. Отдельного масштабирующего преобразования здесь нет
                     намеренно — вместе с размером оно давало бы квадрат масштаба,
                     и лист схлопывался бы в угол. -->
                <Border x:Name="Sheet"
                        Background="{StaticResource Page}"
                        BorderBrush="{StaticResource PageBorder}"
                        BorderThickness="1">
                    <Image x:Name="Picture" Stretch="Fill" />
                </Border>
            </Canvas>
        </ScrollViewer>

        <!-- Подсказка, когда страниц нет: пустой стол сам по себе ничего не объясняет. -->
        <TextBlock x:Name="Placeholder"
                   Text="Отсканируйте страницу кнопкой «Ч/Б» или «Цветное»"
                   FontFamily="{StaticResource UiFont}"
                   FontSize="{StaticResource FontSizeUi}"
                   Foreground="{StaticResource TextSecondary}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False" />
    </Grid>
</UserControl>