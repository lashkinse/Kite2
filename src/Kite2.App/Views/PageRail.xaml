<UserControl x:Class="Kite2.App.Views.PageRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Kite2.App.ViewModels"
             Width="176"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!-- Колонка отсканированных страниц. Слева от области просмотра: привычнее
         ожидать список документов именно здесь, а не снизу. -->
    <Border Background="{StaticResource Rail}"
            BorderBrush="{StaticResource Hairline}"
            BorderThickness="0,0,1,0">
        <ListBox x:Name="List"
                 ItemsSource="{Binding Pages}"
                 SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Center"
                 Padding="0,10"
                 ScrollViewer.CanContentScroll="False">
            <!-- Прокрутка идёт на пиксель, а не по элементам. По элементам колесо
                 прыгало бы на целую миниатюру — мимо двух-трёх страниц за одно
                 движение, и найти нужную невозможно. -->
            <!-- Панель элементов — простой список, а не перенос строк. Перенос
                 выравнивал миниатюры по левому краю и ровнял их в несколько
                 столбцов: колонка страниц от этого переставала быть колонкой. -->
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,0,10" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Plate"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="3"
                                        CornerRadius="4">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Plate" Property="Background" Value="#F0F0F0" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Plate" Property="Background" Value="{StaticResource Selection}" />
                                        <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource Accent}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- Ширина задана явно, равная ширине колонки: миниатюра и её номер
                         встают по центру, а не по левому краю. Размеры миниатюры
                         заданы тоже явно — картинка должна занимать одно и то же
                         место и при пустой колонке, иначе список прыгает. -->
                    <StackPanel Width="150" HorizontalAlignment="Center">
                        <Border Background="White"
                                BorderBrush="{StaticResource PageBorder}"
                                BorderThickness="1"
                                Width="110"
                                Height="156"
                                HorizontalAlignment="Center">
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="{Binding Caption}"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Border>
</UserControl>