<UserControl x:Class="Kite2.App.Views.PageActions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Margin="6">

    <!-- Плавающая панель над выбранной страницей: по цветам повторяет верхнюю
         панель и не отнимает ширины у просмотра. -->
    <Border Background="{StaticResource Bar}"
            BorderBrush="{StaticResource Header}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="4"
            VerticalAlignment="Top"
            HorizontalAlignment="Left">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.4" />
        </Border.Effect>

        <StackPanel>
            <!-- Порядок сверху вниз: поворот, порядок страниц, удаление.
                 Разрушающая команда внизу — на неё не попадают по ошибке. -->
            <Button Style="{StaticResource PageActionButtonStyle}"
                    Tag="{StaticResource IconRotate}"
                    ToolTip="Повернуть страницу на 180° (Ctrl+R)"
                    Command="{Binding RotatePageCommand}" />

            <Button Style="{StaticResource PageActionButtonStyle}"
                    Tag="{StaticResource IconUp}"
                    ToolTip="Переместить страницу выше (Ctrl+↑)"
                    Command="{Binding MovePageUpCommand}" />

            <Button Style="{StaticResource PageActionButtonStyle}"
                    Tag="{StaticResource IconDown}"
                    ToolTip="Переместить страницу ниже (Ctrl+↓)"
                    Command="{Binding MovePageDownCommand}" />

            <Button Style="{StaticResource PageActionButtonStyle}"
                    Tag="{StaticResource IconDelete}"
                    ToolTip="Удалить страницу (Del)"
                    Command="{Binding DeletePageCommand}" />
        </StackPanel>
    </Border>
</UserControl>
