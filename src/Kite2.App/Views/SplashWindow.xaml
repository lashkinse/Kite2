<Window x:Class="Kite2.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Загрузка"
        Width="560"
        Height="340"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bar}"
        FontFamily="{StaticResource UiFont}"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Border BorderBrush="{StaticResource Hairline}" BorderThickness="1">
        <Grid Margin="36">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Логотип: тот же векторный значок сканера, что на панели команд,
                 и подписи — типографикой программы, без растровых картинок. -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Style="{StaticResource CommandIconStyle}"
                      Data="{StaticResource IconScan}"
                      Stroke="{StaticResource TextOnBar}"
                      Width="80"
                      Height="80" />

                <TextBlock Text="Kite"
                           FontSize="44"
                           Foreground="{StaticResource TextOnBar}"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0" />

                <TextBlock Text="Сканирование документов"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Grid Grid.Row="1">
                <TextBlock x:Name="StatusText"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{StaticResource TextPrimary}" />

                        <StackPanel HorizontalAlignment="Right">
                    <TextBlock Text="© Лашкин Сергей (Lashkin Sergey), 2015–2026"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource TextPrimary}"
                               HorizontalAlignment="Right" />

                    <TextBlock Text="github.com/lashkinse"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Right" />

                    <TextBlock x:Name="VersionText"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
