<Window x:Class="Kite2.App.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сообщение"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource FontSizeUi}">

    <!-- Своё окно вместо MessageBox: у MessageBox из WPF нет привязки к окну
         программы, и он встаёт по центру экрана, теряясь среди других окон. -->
    <StackPanel Margin="20">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Значок: восклицательный знак для ошибки, вопрос — когда уточняем. -->
            <Ellipse x:Name="Badge"
                     Grid.Column="0"
                     Width="26"
                     Height="26"
                     VerticalAlignment="Top" />

            <Path x:Name="BadgeText"
                  Grid.Column="0"
                  Style="{StaticResource BadgeIconStyle}"
                  Data="{StaticResource IconQuestion}"
                  Stroke="White" />

            <TextBlock x:Name="Caption"
                       Grid.Column="2"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="{StaticResource TextPrimary}"
                       VerticalAlignment="Center" />
        </Grid>

        <Grid Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="OkButton"
                    Grid.Column="1"
                    MinWidth="110"
                    Height="32"
                    Content="ОК  [Enter]"
                    IsDefault="True"
                    IsCancel="True"
                    Visibility="Collapsed"
                    Click="OnOkClick" />

            <Button x:Name="YesButton"
                    Grid.Column="1"
                    MinWidth="110"
                    Height="32"
                    IsDefault="True"
                    Visibility="Collapsed"
                    Click="OnYesClick" />

            <Button x:Name="NoButton"
                    Grid.Column="3"
                    MinWidth="110"
                    Height="32"
                    IsCancel="True"
                    Visibility="Collapsed"
                    Click="OnNoClick" />
        </Grid>
    </StackPanel>
</Window>