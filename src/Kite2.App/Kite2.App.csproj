<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Kite2.App</RootNamespace>
    <AssemblyName>Kite2</AssemblyName>
    <!-- 64-разрядная сборка: нативная библиотека ImageMagick своя для каждого
         варианта, и под Windows 7 она доступна только под x64. -->
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win;win-x64</RuntimeIdentifiers>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>Kite2</AssemblyTitle>
    <Product>Kite2</Product>
    <Description>Сканирование документов</Description>
    <Version>1.7.64</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Значок программы: без него в проводнике и на панели задач Windows
         показывается пустой значок. -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kite2.Core\Kite2.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Помощник захвата нужен рядом с программой, но не как сборка: он запускается
         как отдельный процесс и должен остаться 32-разрядным. -->
    <ProjectReference Include="..\Kite2.Scan\Kite2.Scan.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Формат обмена лежит рядом с обеими программами: без него помощник не
         запустится. -->
    <ProjectReference Include="..\Kite2.ScanProtocol\Kite2.ScanProtocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Обновлятор нужен рядом с программой как файл, а не как сборка: он
         запускается отдельным процессом и сам подменяет файлы программы. -->
    <ProjectReference Include="..\Kite2.Updater\Kite2.Updater.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <!-- Ссылка на сборку обновлятора тоже копирующая, а файлы запуска кладутся
       рядом с программой целью ниже: сами по себе они снаружи не уедут.
       Помощник несёт целый граф зависимостей NAPS2, и все они кладутся рядом
       с программой одним каталогом: версии общих сборок (NLog, SixLabors.Fonts,
       семейство System.*) выровнены в csproj помощника и приложения так, чтобы
       один и тот же файл годился обоим процессам. -->
  <Target Name="CopySidePrograms" AfterTargets="Build">
    <ItemGroup>
      <ScanProgram Include="$(MSBuildThisFileDirectory)..\Kite2.Scan\bin\*\$(Configuration)\**\Kite2.Scan.exe" />
      <ScanFile Include="%(ScanProgram.RootDir)%(ScanProgram.Directory)**\Kite2.Scan.exe" />
      <ScanFile Include="%(ScanProgram.RootDir)%(ScanProgram.Directory)**\Kite2.Scan.exe.config" />
      <ScanFile Include="%(ScanProgram.RootDir)%(ScanProgram.Directory)**\*.dll" />
      <UpdaterProgram Include="$(MSBuildThisFileDirectory)..\Kite2.Updater\bin\*\$(Configuration)\**\Kite2.Updater.exe" />
      <UpdaterFile Include="%(UpdaterProgram.RootDir)%(UpdaterProgram.Directory)Kite2.Updater.*" />
    </ItemGroup>
    <Error Condition="'@(ScanProgram)' == ''"
           Text="Помощник захвата не собран: без Kite2.Scan.exe программа не увидит сканер." />
    <Error Condition="'@(UpdaterProgram)' == ''"
           Text="Обновлятор не собран: без Kite2.Updater.exe программа не обновится." />
    <!-- Рядом, а не в подпапке: и приложение, и помощник захвата живут из одного
         каталога, как просил пользователь. -->
    <Copy SourceFiles="@(ScanFile)"
          DestinationFiles="@(ScanFile->'$(TargetDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(UpdaterFile)"
          DestinationFiles="@(UpdaterFile->'$(TargetDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <!-- Значок программы читается из exe через System.Drawing.Icon. -->
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Обновление работает из комплекта .NET Framework: запросы к GitHub идут
         через System.Net.Http, а архив новой версии распаковывает ZipFile. -->
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.ZipFile" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="NLog" Version="5.5.1" />
    <!-- Версии общих библиотек жёстко совпадают с версиями помощника: два
         процесса берут сборки из одного каталога, и следить отдельно за
         «лежащим в Scan» набором больше не требуется. -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.10" />
    <PackageReference Include="System.Buffers" Version="4.6.1" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.6.1" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
  </ItemGroup>

</Project>

