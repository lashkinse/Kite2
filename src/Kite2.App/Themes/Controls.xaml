<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Kite2.App.Controls">

    <!-- Кнопка верхней панели. Подпись кнопки задаётся в Content, значок — в Tag.
         Так описание каждой команды помещается в одну строку разметки, а вид у всех
         кнопок один: правится здесь, а не в каждой кнопке. -->
    <Style x:Key="CommandButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,6" />
        <!-- Ширина фиксированная: подписи у кнопок разной длины, и при свободной
             ширине значки разъезжались на разный шаг. Размер подобран по самой
             длинной подписи «Параметры» вместе с сочетанием клавиш. -->
        <Setter Property="Width" Value="88" />
        <Setter Property="Margin" Value="0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!-- Своя рамка фокуса вместо системной: у WPF она рисуется мелким
             пунктиром поверх тёмной панели и выглядит как опечатка. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Plate"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Style="{StaticResource CommandIconStyle}"
                                  Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Stroke="{StaticResource TextOnBar}" />
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{StaticResource TextOnBar}"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Margin="0,4,0,0"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding (controls:CommandBar.Hint), RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{StaticResource TextOnBarHint}"
                                           FontFamily="{StaticResource UiFont}"
                                           FontSize="10"
                                           Margin="0,1,0,0"
                                           HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Рамка клавиатурного фокуса вместо системной: та рисуется
                             мелким пунктиром и на тёмной панели выглядит опечаткой. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Plate" Property="BorderBrush" Value="#8AB4E8" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="#4A4A4A" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="#2E2E2E" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Главное действие: заливается акцентным цветом, чтобы его находили сразу. -->
    <Style x:Key="AccentCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource CommandButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Plate"
                            Background="{StaticResource Accent}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Style="{StaticResource CommandIconStyle}"
                                  Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Stroke="{StaticResource TextOnBar}" />
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{StaticResource TextOnBar}"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Margin="0,4,0,0"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding (controls:CommandBar.Hint), RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{StaticResource TextOnAccentHint}"
                                           FontFamily="{StaticResource UiFont}"
                                           FontSize="10"
                                           Margin="0,1,0,0"
                                           HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Plate" Property="BorderBrush" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{StaticResource AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{StaticResource AccentPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Кнопка полосы над страницей: только значок, на светлом фоне рядом с
         колонкой страниц. Подписи здесь не нужны — команды и так работают с
         выбранной страницей, а сочетание клавиш написано во всплывающей
         подсказке. -->
    <Style x:Key="PageActionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Plate"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Path Style="{StaticResource CommandIconStyle}"
                              Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                              Stroke="{StaticResource TextPrimary}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="#E8F1FC" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{StaticResource Selection}" />
                        </Trigger>
                        <!-- Без выбранной страницы команды не работают, и значки
                             гаснут: полоса не зовёт на пустом месте. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.25" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolBarSeparatorStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="14,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="#4A4A4A" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Узкая полоса прокрутки: в прежней версии она тоже была тонкой, иначе
         колонка страниц съедала треть экрана. -->
    <Style x:Key="SlimScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{StaticResource ScrollThumb}" CornerRadius="3" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
