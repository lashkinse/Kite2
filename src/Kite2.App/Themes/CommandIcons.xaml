<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Значки верхней панели. Нарисованы геометрией, а не картинками: остаются
         резкими при любом масштабе и не занимают ресурсов сборки.
         Сетка значка 24 на 24, обводка задаётся в стиле CommandIconStyle. -->

    <!-- Лист со знаком плюса: новый документ. Плюс нарисован линиями, а не
         заливкой: значок рисуется обводкой, и залитый прямоугольник вышел бы
         двумя крошечными квадратами. -->
    <Geometry x:Key="IconNew">M 6,2.5 H 17 A 2,2 0 0 1 19,4.5 V 19 A 2,2 0 0 1 17,21.5 H 7 A 2,2 0 0 1 5,19.5 V 4.5 A 2,2 0 0 1 6,2.5 Z M 12,8.5 V 15.5 M 8.5,12 H 15.5</Geometry>

    <!-- Стрелка вниз в лоток: сохранение -->
    <Geometry x:Key="IconSave">M 12,3 V 14 M 7.5,10 L 12,14.5 L 16.5,10 M 4,16.5 V 19 A 1.5,1.5 0 0 0 5.5,20.5 H 18.5 A 1.5,1.5 0 0 0 20,19 V 16.5</Geometry>

    <!-- Сканер и чёрно-белые линии -->
    <Geometry x:Key="IconScanMono">M 3,7 V 5 A 1.5,1.5 0 0 1 4.5,3.5 H 19.5 A 1.5,1.5 0 0 1 21,5 V 7 M 3,17 H 21 M 3,17 V 19 A 1.5,1.5 0 0 0 4.5,20.5 H 19.5 A 1.5,1.5 0 0 0 21,19 V 17 M 6.5,10 H 17.5 M 6.5,13.5 H 13</Geometry>

    <!-- Сканер и цветные полосы -->
    <Geometry x:Key="IconScanColour">M 3,7 V 5 A 1.5,1.5 0 0 1 4.5,3.5 H 19.5 A 1.5,1.5 0 0 1 21,5 V 7 M 3,17 H 21 M 3,17 V 19 A 1.5,1.5 0 0 0 4.5,20.5 H 19.5 A 1.5,1.5 0 0 0 21,19 V 17 M 6.5,10 H 17.5 M 6.5,13.5 H 11</Geometry>

    <!-- Настройки: три ползунка. Шестерёнка в контурном рисунке не читалась —
         зубья на сетке 24 на 24 выглядели как лучи солнца, и значок означал
         совсем другое. -->
    <Geometry x:Key="IconSettings">M 4,7 H 20 M 4,12 H 20 M 4,17 H 20 M 7.2,7 A 1.8,1.8 0 1 1 10.8,7 A 1.8,1.8 0 1 1 7.2,7 M 13.2,12 A 1.8,1.8 0 1 1 16.8,12 A 1.8,1.8 0 1 1 13.2,12 M 5.2,17 A 1.8,1.8 0 1 1 8.8,17 A 1.8,1.8 0 1 1 5.2,17</Geometry>

    <!-- Дискета: сохранение выделенного фрагмента. Ножницы читались как обрезка,
         а обрезки в программе нет — фрагмент сохраняется рядом.

         Залита цветом, а не нарисована контуром: в контуре шторка и этикетка
         превращались в две одинаковые прорези, и значок читался как вентиляционная
         решётка. Заливка держит форму целиком, а размеры у деталей разные: шторка
         узкая и сверху, этикетка шире и ниже — как у настоящей дискеты. -->
    <Geometry x:Key="IconSaveFragment">M 5,3 H 19 A 2,2 0 0 1 21,5 V 19 A 2,2 0 0 1 19,21 H 5 A 2,2 0 0 1 3,19 V 5 A 2,2 0 0 1 5,3 Z M 9,4 H 15 V 10 H 9 Z M 7,12 H 17 V 19 H 7 Z</Geometry>

    <!-- Корзина: удалить страницу -->
    <Geometry x:Key="IconDelete">M 4.5,6.5 H 19.5 M 9.5,6.5 V 4.5 H 14.5 V 6.5 M 6.5,6.5 L 7.5,20 A 1,1 0 0 0 8.5,20.5 H 15.5 A 1,1 0 0 0 16.5,20 L 17.5,6.5 M 10,10 V 17 M 14,10 V 17</Geometry>

    <!-- Стрелка вверх: страница выше -->
    <Geometry x:Key="IconUp">M 8,14.5 L 12,10 L 16,14.5</Geometry>

    <!-- Стрелка вниз: страница ниже -->
    <Geometry x:Key="IconDown">M 8,9.5 L 12,14 L 16,9.5</Geometry>

    <!-- Круговая стрелка: дуга на 270° и наконечник на её конце. Дуга и
         наконечник считались от центра (12, 12) радиусом 7.5 — раньше концы
         дуги стояли выше круга, и значок уезжал вверх. -->
    <Geometry x:Key="IconRotate">M 17.3,17.3 A 7.5,7.5 0 1 1 17.3,6.7 M 16,7.6 L 19.1,8.5 L 18.2,5.4</Geometry>

    <!-- Восклицательный знак и вопрос для окна сообщения. Рисуются линиями, а не
         набором текста: буква в круге всегда стоит чуть выше или ниже середины из-за
         высоты строки, и знак сбивается с центра. -->
    <Geometry x:Key="IconAlert">M 12,5.5 L 12,14 M 12,17.9 L 12,18.1</Geometry>

    <Geometry x:Key="IconQuestion">M 8.4,9 C 8.4,5.5 15.6,5.5 15.6,9 C 15.6,12 12,11.8 12,15 M 12,18 L 12,18.2</Geometry>

    <!-- Значки нарисованы на сетке 24 на 24 и увеличиваются преобразованием:
         так сетка остаётся целой, а размер значка меняется в одном месте.

         Преобразование именно Render, а не Layout: LayoutTransform в WPF
         масштабирует от середины, но занимаемое место уменьшает, и содержимое
         уезжает на четверть размера — значок встаёт не по центру. RenderTransform
         двигает только рисунок, место остаётся, и центр остаётся центром. -->
    <Style x:Key="CommandIconStyle" TargetType="Path">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="StrokeThickness" Value="1.8" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1.17" ScaleY="1.17" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Значок внутри круга окна сообщения: тот же рисунок, но мельче — в круг
         знак иначе не помещался. -->
    <Style x:Key="BadgeIconStyle" TargetType="Path" BasedOn="{StaticResource CommandIconStyle}">
        <Setter Property="StrokeThickness" Value="2.4" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="0.62" ScaleY="0.62" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Значок на кнопке поверх страницы: та же сетка 24 на 24, без увеличения —
         кнопка меньше панели команд, и значок должен занять её целиком.
         Без обводки: этот значок залит цветом, а обводка ему только мешала. -->
    <Style x:Key="ChipIconStyle" TargetType="Path" BasedOn="{StaticResource CommandIconStyle}">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
