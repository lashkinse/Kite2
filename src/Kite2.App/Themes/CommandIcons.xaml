<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Значки верхней панели. Нарисованы геометрией, а не картинками: остаются
         резкими при любом масштабе и не занимают ресурсов сборки.
         Сетка значка 24 на 24, обводка задаётся в стиле CommandIconStyle. -->

    <!-- Лист со знаком плюса: новый документ. Плюс нарисован линиями, а не
         заливкой: значок рисуется обводкой, и залитый прямоугольник вышел бы
         двумя крошечными квадратами. -->
    <Geometry x:Key="IconNew">M 6,2.5 H 17 A 2,2 0 0 1 19,4.5 V 19 A 2,2 0 0 1 17,21.5 H 7 A 2,2 0 0 1 5,19.5 V 4.5 A 2,2 0 0 1 6,2.5 Z M 12,8.5 V 15.5 M 8.5,12 H 15.5</Geometry>

    <!-- Стрелка вниз в лоток: сохранение -->
    <Geometry x:Key="IconSave">M 12,3 V 14 M 7.5,10 L 12,14.5 L 16.5,10 M 4,16.5 V 19 A 1.5,1.5 0 0 0 5.5,20.5 H 18.5 A 1.5,1.5 0 0 0 20,19 V 16.5</Geometry>

    <!-- Сканер и чёрно-белые линии -->
    <Geometry x:Key="IconScanMono">M 3,7 V 5 A 1.5,1.5 0 0 1 4.5,3.5 H 19.5 A 1.5,1.5 0 0 1 21,5 V 7 M 3,17 H 21 M 3,17 V 19 A 1.5,1.5 0 0 0 4.5,20.5 H 19.5 A 1.5,1.5 0 0 0 21,19 V 17 M 6.5,10 H 17.5 M 6.5,13.5 H 13</Geometry>

    <!-- Сканер и цветные полосы -->
    <Geometry x:Key="IconScanColour">M 3,7 V 5 A 1.5,1.5 0 0 1 4.5,3.5 H 19.5 A 1.5,1.5 0 0 1 21,5 V 7 M 3,17 H 21 M 3,17 V 19 A 1.5,1.5 0 0 0 4.5,20.5 H 19.5 A 1.5,1.5 0 0 0 21,19 V 17 M 6.5,10 H 17.5 M 6.5,13.5 H 11</Geometry>

    <!-- Шестерёнка: выбор источника сканирования. Зубцы короткие и сразу за
         ободком: длинные лучи читались как солнце, а не как шестерёнка. -->
    <Geometry x:Key="IconSettings">M 5,12 A 7,7 0 1 1 19,12 A 7,7 0 1 1 5,12 M 12,8.8 A 3.2,3.2 0 1 1 11.99,8.8 A 3.2,3.2 0 1 1 12,8.8 M 12,7.4 V 4.6 M 12,16.6 V 19.4 M 7.4,12 H 4.6 M 16.6,12 H 19.4 M 8.75,8.75 L 7.05,7.05 M 15.25,15.25 L 16.95,16.95 M 15.25,8.75 L 16.95,7.05 M 8.75,15.25 L 7.05,16.95</Geometry>

    <!-- Корзина: удалить страницу -->
    <Geometry x:Key="IconDelete">M 4.5,6.5 H 19.5 M 9.5,6.5 V 4.5 H 14.5 V 6.5 M 6.5,6.5 L 7.5,20 A 1,1 0 0 0 8.5,20.5 H 15.5 A 1,1 0 0 0 16.5,20 L 17.5,6.5 M 10,10 V 17 M 14,10 V 17</Geometry>

    <!-- Стрелка вверх: страница выше -->
    <Geometry x:Key="IconUp">M 8,14.5 L 12,10 L 16,14.5</Geometry>

    <!-- Стрелка вниз: страница ниже -->
    <Geometry x:Key="IconDown">M 8,9.5 L 12,14 L 16,9.5</Geometry>

    <!-- Круговая стрелка: дуга на 270° и наконечник на её конце. Дуга и
         наконечник считались от центра (12, 12) радиусом 7.5 — раньше концы
         дуги стояли выше круга, и значок уезжал вверх. -->
    <Geometry x:Key="IconRotate">M 17.3,17.3 A 7.5,7.5 0 1 1 17.3,6.7 M 16,7.6 L 19.1,8.5 L 18.2,5.4</Geometry>

    <!-- Ножницы: обрезка выделенного участка страницы. Кольца и лезвия, как
         у обычных ножниц, — знак обрезки узнаётся сразу. -->
    <Geometry x:Key="IconCrop">M 6.4,19.6 A 2.6,2.6 0 1 1 6.4,14.4 A 2.6,2.6 0 1 1 6.4,19.6 Z M 17.6,19.6 A 2.6,2.6 0 1 1 17.6,14.4 A 2.6,2.6 0 1 1 17.6,19.6 Z M 8.4,14.9 L 18.4,4.4 M 15.6,14.9 L 5.6,4.4</Geometry>

    <!-- Значки нарисованы на сетке 24 на 24 и увеличиваются преобразованием:
         так сетка остаётся целой, а размер значка меняется в одном месте. -->
    <Style x:Key="CommandIconStyle" TargetType="Path">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="StrokeThickness" Value="1.8" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="LayoutTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1.17" ScaleY="1.17" />
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>