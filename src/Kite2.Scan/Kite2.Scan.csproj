<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- Помощник 32-разрядный: WIA-драйверы живут в процессе-потребителе,
         а у части старых сканеров они выпущены только под x86. -->
    <PlatformTarget>x86</PlatformTarget>
    <Platforms>x64</Platforms>
    <RootNamespace>Kite2.Scan</RootNamespace>
    <AssemblyName>Kite2.Scan</AssemblyName>
    <!-- C# 8 нужен ради «await foreach»: страницы прилетают потоком от NAPS2. -->
    <LangVersion>8.0</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>Kite2.Scan</AssemblyTitle>
    <Description>Захват изображений со сканера</Description>
    <!-- Версия ходит в ногу с программой: штамп в журнале помощника говорит,
         какой именно бинарь исполнялся на компьютере пользователя. -->
    <Version>1.7.59</Version>
  </PropertyGroup>

  <!-- Папка сборки повторяет решение (x64), хотя сама программа 32-разрядная:
       сборка решения одна на все проекты. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>bin\x64\Release\</OutputPath>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="5.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kite2.ScanProtocol\Kite2.ScanProtocol.csproj" />
  </ItemGroup>

  <!-- Лишнее срезается прямо с выхода сборки: собственные PDF-экспорт и
       спутниковые переводы NAPS2 не нужны. Транспорт eSCL не трогается:
       тип EsclOptions живёт в конструкторе ScanOptions. -->
  <Target Name="TrimScanOutput" AfterTargets="Build">
    <ItemGroup>
      <SatelliteTranslations Include="$(TargetDir)*\NAPS2.Sdk.resources.dll" />
    </ItemGroup>
    <Delete Files="%(SatelliteTranslations.FullPath)" />
    <RemoveDir Directories="%(SatelliteTranslations.RootDir)%(SatelliteTranslations.Directory)" />
    <ItemGroup>
      <!-- NAPS2.Escl и весь его транспорт обязаны гулять целиком: ScanOptions
           конструирует EsclOptions, а тот цепляет gRPC и DNS всё разом. -->
      <UnusedSideFiles Include="
        $(TargetDir)_win32\**\*;
        $(TargetDir)zxing.presentation.dll;
        $(TargetDir)PdfSharpCore.dll;
        $(TargetDir)ICSharpCode.SharpZipLib.dll;" />
    </ItemGroup>
    <Delete Files="@(UnusedSideFiles)" />
  </Target>

  <ItemGroup>
    <!-- Движок сканирования — NAPS2.Sdk (LGPL): WIA ведётся тем же API, а разбор
         страниц при передаче сделан внутри библиотеки и обкатан на сотнях
         моделей. Пакеты NAPS2 выпущены под LGPL 2.1 — динамическая сборка не
         делает нашу программу частью NAPS2. -->
    <PackageReference Include="NAPS2.Sdk" Version="1.5.0" />
    <!-- Бэкенд изображений на System.Drawing: он превращает отсканированные
         страницы в файлы, которые умеет читать страница сжатия программы. -->
    <PackageReference Include="NAPS2.Images.Gdi" Version="1.5.0" />
  </ItemGroup>

</Project>

