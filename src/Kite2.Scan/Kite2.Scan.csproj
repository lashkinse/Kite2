<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- Помощник 32-разрядный не по выбору, а по необходимости: драйверы TWAIN
         грузятся только в 32-разрядный процесс, и в 64-разрядном их не будет вовсе. -->
    <PlatformTarget>x86</PlatformTarget>
    <Platforms>x64</Platforms>
    <RootNamespace>Kite2.Scan</RootNamespace>
    <AssemblyName>Kite2.Scan</AssemblyName>
    <!-- C# 8 нужен ради «await foreach»: страницы прилетают потоком от NAPS2. -->
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>Kite2.Scan</AssemblyTitle>
    <Description>Захват изображений со сканера</Description>
    <!-- Версия ходит в ногу с программой: штамп в журнале помощника говорит,
         какой именно бинарь исполнялся на компьютере пользователя. -->
    <Version>1.7.35</Version>
  </PropertyGroup>

  <!-- Папка сборки повторяет решение (x64), хотя сама программа 32-разрядная:
       сборка решения одна на все проекты. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>bin\x64\Release\</OutputPath>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="5.5.1" />
    <!-- Снимки стеков живых потоков для диагностики молчащей передачи. -->
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="3.1.512801" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kite2.ScanProtocol\Kite2.ScanProtocol.csproj" />
    <!-- Вендоренный NTwain с локальной правкой: перед виснущим на Kyocera
         DAT_PENDINGXFERS/MSG_GET делается спек-легальный звонок
         DAT_IMAGEINFO/MSG_GET (только для KYOCERA-драйверов). Пакет
         NAPS2.NTwain от этого исключается — его место занимает наша сборка
         с тем же именем и той же версией (1.0.0.0). -->
    <ProjectReference Include="..\Kite2.NTwain\NTwain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Запретить транзитивный NAPS2.NTwain: иначе рядом положат пакетный
         NTwain.dll без правки, и кто-то из двух загрузится первым. -->
    <PackageReference Include="NAPS2.NTwain" Version="1.0.1" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Нативный TWAIN-диспетчер 2.x: NuGet-пакеты NAPS2 его не раздают, а сам
         NAPS2 вендорит из исходников TWAIN Working Group (LGPL, как и Sdk).
         Без него список устройств строится через старый C:\Windows\twain_32.dll,
         а второе открытие этого диспетчера в одном процессе на части машин
         зависает. Файл лежит рядом с помощником: LoadLibrary по умолчанию
         ищет его в каталоге экзешника, подпапка _win32 не обязательна. -->
    <None Include="Native\x86\twaindsm.dll" Link="twaindsm.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- Лишнее срезается прямо с выхода сборки: не нужны WPF-реализация zxing,
       PDF-экспорт внутри NAPS2 (PdfSharpCore, SharpZipLib) и полсотни
       спутниковых переводов NAPS2. Транспорт eSCL (NAPS2.Escl, gRPC, DNS)
       обрезка не трогает: тип EsclOptions живёт в конструкторе ScanOptions,
       и его цепочка зависимостей обязана быть рядом. Копия ниток и сканера
       раскладывается в Scan\ через CopySidePrograms — чем меньше файлов, тем
       компактнее поставка. Драйвер по умолчанию тут TWAIN и WIA, а лог
       помощник пишет сам, на своём русском. -->
  <Target Name="TrimScanOutput" AfterTargets="Build">
    <ItemGroup>
      <SatelliteTranslations Include="$(TargetDir)*\NAPS2.Sdk.resources.dll" />
    </ItemGroup>
    <Delete Files="%(SatelliteTranslations.FullPath)" />
    <RemoveDir Directories="%(SatelliteTranslations.RootDir)%(SatelliteTranslations.Directory)" />
    <ItemGroup>
      <!-- NAPS2.Escl и весь его транспорт обязаны гулять целиком: ScanOptions
           конструирует EsclOptions, а тот цепляет gRPC и DNS всё разом. -->
      <UnusedSideFiles Include="
        $(TargetDir)_win32\**\*;
        $(TargetDir)zxing.presentation.dll;
        $(TargetDir)PdfSharpCore.dll;
        $(TargetDir)ICSharpCode.SharpZipLib.dll;" />
    </ItemGroup>
    <Delete Files="@(UnusedSideFiles)" />
  </Target>

  <ItemGroup>
    <!-- Движок сканирования — NAPS2.Sdk: один API закрывает TWAIN (оба диспетчера)
         и WIA, а разбор страниц при любом механизме передачи сделан внутри
         библиотеки и обкатан на сотнях моделей. Сами пакеты NAPS2 выпущены под
         LGPL 2.1 — динамическая сборка не делает нашу программу частью NAPS2. -->
    <PackageReference Include="NAPS2.Sdk" Version="1.5.0" />
    <!-- Бэкенд изображений на System.Drawing: он превращает отсканированные
         страницы в файлы, которые умеет читать страница сжатия программы. -->
    <PackageReference Include="NAPS2.Images.Gdi" Version="1.5.0" />
  </ItemGroup>

</Project>

