<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- Помощник 32-разрядный не по выбору, а по необходимости: драйверы TWAIN
         грузятся только в 32-разрядный процесс, и в 64-разрядном их не будет вовсе. -->
    <PlatformTarget>x86</PlatformTarget>
    <Platforms>x64</Platforms>
    <RootNamespace>Kite2.Scan</RootNamespace>
    <AssemblyName>Kite2.Scan</AssemblyName>
    <!-- C# 8 нужен ради «await foreach»: страницы прилетают потоком от NAPS2. -->
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>Kite2.Scan</AssemblyTitle>
    <Description>Захват изображений со сканера</Description>
  </PropertyGroup>

  <!-- Папка сборки повторяет решение (x64), хотя сама программа 32-разрядная:
       сборка решения одна на все проекты. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>bin\x64\Release\</OutputPath>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="5.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kite2.ScanProtocol\Kite2.ScanProtocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Новый TWAIN-диспетчер (2.x) живёт одноимённой нативной dll, которую
         NuGet-пакеты NAPS2 не раздают вовсе, а сам NAPS2 вендорит из исходников
         TWAIN Working Group (LGPL, как и Sdk). Без неё оба списка устройств
         строятся через старый C:\Windows\twain_32.dll, а второе открытие этого
         диспетчера в одном процессе на части машин зависает. NAPS2 ищет файл
         в подпапке _win32 (поиск для 32-разрядных сборок). -->
    <None Include="Native\x86\twaindsm.dll" Link="_win32\twaindsm.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Движок сканирования — NAPS2.Sdk: один API закрывает TWAIN (оба диспетчера)
         и WIA, а разбор страниц при любом механизме передачи сделан внутри
         библиотеки и обкатан на сотнях моделей. Сами пакеты NAPS2 выпущены под
         LGPL 2.1 — динамическая сборка не делает нашу программу частью NAPS2. -->
    <PackageReference Include="NAPS2.Sdk" Version="1.5.0" />
    <!-- Бэкенд изображений на System.Drawing: он превращает отсканированные
         страницы в файлы, которые умеет читать страница сжатия программы. -->
    <PackageReference Include="NAPS2.Images.Gdi" Version="1.5.0" />
  </ItemGroup>

</Project>
