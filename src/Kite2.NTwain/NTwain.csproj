<Project Sdk="Microsoft.NET.Sdk">

  <!-- Вендоренный NTwain (декомпиляция того бинаря, который стоит рядом с
       NAPS2.Sdk): база MIT (soukoku/ntwain) плюс правки NAPS2 (LGPL 2.1).
       Нужен ради точечного доступа к нулевой точке передачи — первой
       четвёрке-триплету после XferReady, на которой Kyocera TWAIN(2) замолкает
       намертво. Внешнее поведение прежнее, отличается только добавленный
       звонок DAT_IMAGEINFO перед PendingXfers.Get для драйверов Kyocera. -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>NTwain</AssemblyName>
    <RootNamespace>NTwain</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0109;CS1570;CS0649;CS0067;CS0168;CS0219;CS0219;CS8019;SYSLIB0011</NoWarn>
  </PropertyGroup>

</Project>


