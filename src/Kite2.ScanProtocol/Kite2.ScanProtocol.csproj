<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <!-- Формат обмена нужен и 64-разрядной программе, и 32-разрядному помощнику,
         поэтому сборка здесь любая: её читают оба. Без этого указания сборка
         решения утянула бы библиотеку под x64 и помощник её не загрузил. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Platforms>x64</Platforms>
    <RootNamespace>Kite2.ScanProtocol</RootNamespace>
    <AssemblyName>Kite2.ScanProtocol</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>bin\x64\Release\</OutputPath>
    <Optimize>true</Optimize>
  </PropertyGroup>

</Project>
