<Project Sdk="Microsoft.NET.Sdk">

  <!-- Обследователь TWAIN-драйвера: отдельная консольная программа, один прогон
       «Кхэт» выявляет, какая последовательность троек-триплетов после XferReady
       живёт, а какая висит навсегда, и складывает таблицу вердиктов в один
       файл отчёта. От программы-помощника не зависит вовсе: свои структуры
       (в точности как в вендоренном NTwain), свой Newtonsoft-фри лог. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- TWAIN-драйверы живут только в 32-разрядном процессе. -->
    <PlatformTarget>x86</PlatformTarget>
    <RootNamespace>Kite2.Probe</RootNamespace>
    <AssemblyName>Kite2.Probe</AssemblyName>
    <Version>1.0.18</Version>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>Kite2 Probe</AssemblyTitle>
    <Description>Обследование TWAIN-драйвера ручными триплетами</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Снимок стеков висящего ребёнка (тот же снимок, что делает помощник). -->
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="3.1.512801" />
    <!-- ClrMD ссылается на 6.0.0.0, у помощника в bin устаревшая копия —
         держим свою правильную и свой BindingRedirect. -->
    <PackageReference Include="System.Collections.Immutable" Version="6.0.0" />
  </ItemGroup>

</Project>

